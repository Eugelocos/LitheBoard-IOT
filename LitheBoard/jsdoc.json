{
  "source": {
    "include": ["backend"],
    "includePattern": ".*\\.js$",
    "excludePattern": "(node_modules|dist)"
  },
  "opts": {
    "destination": "./docs",
    "template": "node_modules/clean-jsdoc-theme",
    "recurse": true
  },
  "templates": {
    "cleans": {
      "theme": "fallblack"
    },
    "theme_opts": {
      "favicon": "./src/ogo_litheboard.png",
      "homepageTitle": "Litheboard Docs",

      "include_css": ["./jsdoc_custom_styles.css"]
    }
  },
  "plugins": [],
  "tags": {
    "allowUnknownTags": true
  }
}
